{
  "name": "dev-console",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "tauri:dev": ". \"$HOME/.cargo/env\" && tauri dev",
    "tauri:build": ". \"$HOME/.cargo/env\" && tauri build",
    "lint:rust": ". \"$HOME/.cargo/env\" && cargo fmt --check --manifest-path src-tauri/Cargo.toml && cargo clippy --manifest-path src-tauri/Cargo.toml -- -D warnings",
    "test:e2e": "node e2e/packaged-monaco.e2e.mjs"
  },
  "dependencies": {
    "@cyoda/agent-bridge-contract": "workspace:*",
    "@cyoda/console-design-system": "workspace:*",
    "@cyoda/console-shell": "workspace:*",
    "@cyoda/entity-model-viewer": "workspace:*",
    "@cyoda/workflow-core": "0.8.0",
    "@cyoda/workflow-editor-host": "workspace:*",
    "@cyoda/workflow-file-indexer": "workspace:*",
    "@cyoda/workflow-graph": "0.4.3",
    "@cyoda/workflow-layout": "0.1.8",
    "@cyoda/workflow-monaco": "0.3.0",
    "@cyoda/workflow-project-model": "workspace:*",
    "@cyoda/workflow-react": "0.7.0",
    "@cyoda/workflow-viewer": "0.5.0",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-virtual": "^3.14.26",
    "@tauri-apps/api": "^2.12.4",
    "lucide-react": "^1.71.0",
    "monaco-editor": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "reactflow": "catalog:",
    "uuid": "catalog:",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "^14.6.9",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "happy-dom": "^21.0.4",
    "selenium-webdriver": "^4.52.0",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
